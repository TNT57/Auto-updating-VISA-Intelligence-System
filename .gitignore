# Environment
.env
.env.local
*.env
# .env.bak and friends: "*.env" does not match ".env.bak", so a backup of a
# secrets file would otherwise be committable.
*.bak
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
*.egg

# Virtual environments
venv/
.venv/
env/

# Local caches (keeps everything inside project, not on C: drive)
.cache/
.pytest_cache/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Data files (large/binary)
data/raw/pdfs/*.pdf
# Conditional-GET markers written alongside each downloaded PDF
data/raw/pdfs/*.etag
data/raw/html_snapshots/
data/raw/*.txt
data/raw/*.html
data/processed/
data/archives/
!data/raw/pdfs/.gitkeep
!data/raw/html_snapshots/.gitkeep
!data/processed/.gitkeep
!data/archives/.gitkeep

# Database
database/vectorstore/
database/*.db
!database/.gitkeep

# Logs
logs/

# OS
.DS_Store
Thumbs.db

# Streamlit
.streamlit/secrets.toml

# Jupyter
.ipynb_checkpoints/
*.ipynb