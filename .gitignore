# Environment
.env
.env.local
*.env
# .env.bak and friends: "*.env" does not match ".env.bak", so a backup of a
# secrets file would otherwise be committable.
*.bak
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
*.egg

# Virtual environments
venv/
.venv/
env/

# Local caches (keeps everything inside project, not on C: drive)
.cache/
.pytest_cache/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Data files (large/binary)
data/raw/pdfs/*.pdf
# Conditional-GET markers written alongside each downloaded PDF
data/raw/pdfs/*.etag
# Quarantined documents. 485_visa_info.pdf was generated by the old
# create_sample_pdf.py and contains INVENTED visa details; it outranked the
# real Home Affairs pages until it was pulled from the index. Fabricated
# immigration information must not ship in a public repo.
data/raw/pdfs_excluded/
data/raw/html_snapshots/
data/raw/*.txt
data/raw/*.html
data/processed/
data/archives/
!data/raw/pdfs/.gitkeep
!data/raw/html_snapshots/.gitkeep
!data/processed/.gitkeep
!data/archives/.gitkeep

# Database
# The vector store IS committed (~8MB): Streamlit Cloud deploys from a git
# clone with an ephemeral filesystem, so an ignored index means the deployed
# app starts with an empty knowledge base and can answer nothing. Committing
# it also makes a deploy reproducible — the app ships the corpus it was
# tested against. Rebuild with scripts/fetch_and_index.py.
database/*.db
database/vectorstore_old_*/
!database/.gitkeep

# Local-only Chroma state that must not be committed
database/vectorstore/*.log

# Logs
logs/

# OS
.DS_Store
Thumbs.db

# Streamlit
.streamlit/secrets.toml

# Jupyter
.ipynb_checkpoints/
*.ipynb