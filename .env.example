# ============================================
# Auto-Updating 485 Visa Intelligence System
# Environment Configuration
# ============================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# ---- LLM Configuration ----
# Get your free Groq API key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# ---- Optional: OpenAI (alternative LLM) ----
# OPENAI_API_KEY=your_openai_api_key_here

# ---- Embedding Model ----
# Default: all-MiniLM-L6-v2 (runs locally, no API key needed)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ---- Discord Alerts (Phase 3) ----
# DISCORD_WEBHOOK_URL=your_discord_webhook_url_here

# ---- Email Alerts (Phase 3, optional) ----
# SMTP_SERVER=smtp.gmail.com
# SMTP_PORT=587
# EMAIL_ADDRESS=your_email@gmail.com
# EMAIL_PASSWORD=your_app_password_here
# ALERT_RECIPIENTS=recipient1@gmail.com,recipient2@gmail.com

# ---- Scraping Configuration ----
# Rate limit in seconds between requests (be respectful to government servers)
SCRAPING_DELAY=5
# User agent for HTTP requests
USER_AGENT=Visa485IntelligenceBot/1.0 (Educational Project; contact@example.com)

# ---- Application Settings ----
# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
# ChromaDB persistence directory
CHROMA_PERSIST_DIR=database/vectorstore
# Maximum chunk size for text splitting
CHUNK_SIZE=1000
# Overlap between chunks
CHUNK_OVERLAP=200

# ---- Cache Directories (keeps everything inside project, NOT on C: drive) ----
# HuggingFace models cache (embedding models, etc.)
HF_HOME=.cache/huggingface
# PyTorch model hub cache
TORCH_HOME=.cache/torch
